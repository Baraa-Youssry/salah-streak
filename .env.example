# Supabase (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
# Server-only. Never expose to the browser. Used by the cron reminder job.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SECRET_SERVICE_ROLE_KEY

# Web Push VAPID keys — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the VAPID subject (mailto: or https: URL; no localhost)
VAPID_SUBJECT=mailto:you@example.com

# Shared secret for the reminder cron route.
# Generate: openssl rand -hex 32
# Must match the Supabase Vault secret named 'cron_secret' (see README).
CRON_SECRET=

# Public site URL, no trailing slash.
# Must match the Supabase Vault secret named 'site_url' (see README).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

